# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋 금지)
# Supabase 대시보드 > Project Settings > API
VITE_SUPABASE_URL=https://aelomkubcfpeifkwofhd.supabase.co
# "anon public" 키만 사용하세요. service_role 키는 절대 넣지 마세요!
VITE_SUPABASE_ANON_KEY=

# Pixabay 사진 (서버리스 함수 api/pixabay.js 에서만 사용: 브라우저에 노출되지 않도록 VITE_ 를 붙이지 마세요)
# 로컬에서는 npx vercel dev 로 실행할 때만 필요. Vercel 에는 대시보드에서 등록.
PIXABAY_API_KEY=
